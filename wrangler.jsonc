{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yuulee-blog",
  "compatibility_date": "2026-09-01",
  // Build before wrangler deploy, independent of the dashboard Build command setting
  "build": { "command": "npm run build" },
  // Pure static site: only upload dist, no Worker code
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Only reachable via the custom domain; disable *.workers.dev
  "workers_dev": false,
  "routes": [{ "pattern": "blog.yuulee521.com", "custom_domain": true }],
}
